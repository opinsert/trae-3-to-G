# 视觉与文本 AI 中转站配置
VISION_OCR_API_KEY=您的_API_Key
VISION_OCR_BASE_URL=https://api.apiyi.com
VISION_OCR_MODEL=gpt-5.6-terra
VISION_OCR_TIMEOUT=60
VISION_OCR_ENABLED=true

# VISION_OCR_MODEL 必须支持 image_url 视觉输入；API Key 请通过本机配置提供，不要写入安装包。
# AI 文本提取和 STL 工艺规划复用上面的 VISION_OCR_* 配置

# 应用配置
DEBUG=false

# CORS 允许的源（逗号分隔，生产环境请配置实际域名）
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# JWT 安全配置（生产环境请替换为随机强密钥）
SECRET_KEY=请替换为随机强密钥
