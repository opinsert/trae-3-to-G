# OpenClawPlan视觉OCR配置（推荐，用于工序卡图片识别）
VISION_OCR_API_KEY=您的_OpenClawPlan_API_Key
VISION_OCR_BASE_URL=https://api.openclawplan.com
VISION_OCR_MODEL=gpt-5.5-xhigh
VISION_OCR_TIMEOUT=60
VISION_OCR_ENABLED=true

# 百度OCR API配置（可选，用于视觉OCR失败时兜底）
BAIDU_APP_ID=您的App_ID
BAIDU_API_KEY=您的API_Key
BAIDU_SECRET_KEY=您的Secret_Key

# DeepSeek API配置（可选，用于AI参数提取）
DEEPSEEK_API_KEY=您的DeepSeek_API_Key

# 应用配置
DEBUG=false

# CORS 允许的源（逗号分隔，生产环境请配置实际域名）
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# JWT 安全配置（生产环境请替换为随机强密钥）
SECRET_KEY=请替换为随机强密钥
